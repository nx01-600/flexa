DATABASE_URL="postgresql://flexa:flexa@localhost:5433/flexa?schema=public"
# Local dev only. Unset or any other value is treated as production: the placeholder secret below is refused and Swagger is off.
NODE_ENV=development
# Required, 16+ characters. This placeholder is for local dev only: unless NODE_ENV is development or test, the API refuses to start with it.
JWT_SECRET="dev-only-secret-change-before-deploying"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Max attempts per minute per IP on /auth/login and /auth/register (default 20)
THROTTLE_LIMIT=20
